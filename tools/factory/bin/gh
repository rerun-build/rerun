#!/bin/sh
KEY=${FACTORY_GH_KEY:-/data/tools/github/token}
APP=${FACTORY_GH_APP:-/run/factory-token/token}
REAL=${FACTORY_GH_REAL:-/data/tools/gh/bin/gh}
if [ ! -r "$KEY" ]; then echo "gh wrapper: no GitHub token file yet ($KEY). Tell @boss." >&2; exit 78; fi
export GH_CONFIG_DIR=${FACTORY_GH_CONFIG:-/data/tools/gh/config} GH_PROMPT_DISABLED=1 GH_NO_UPDATE_NOTIFIER=1
export GIT_CONFIG_GLOBAL=${FACTORY_GIT_CONFIG:-/data/tools/git/gitconfig}
case "$1 $2" in "auth token"|"auth status"|"auth login"|"auth logout"|"auth refresh"|"auth setup-git") echo "gh wrapper: 'gh auth' is disabled here." >&2; exit 64;; esac
if [ "${FACTORY_DISPATCHER:-}" != "1" ]; then
    case "$1 $2" in "pr merge") echo "gh wrapper: 'gh pr merge' is restricted to the factory dispatcher." >&2; exit 64;; esac
    if [ "$1" = "api" ]; then
        for a in "$@"; do
            case "$a" in */pulls/*/merge|*/pulls/*/merge\?*|\'*/pulls/*/merge*|\"*/pulls/*/merge*) echo "gh wrapper: pull request merge is restricted to the factory dispatcher." >&2; exit 64;; esac
        done
    fi
fi

MODE=''
case "$1 $2" in
    "issue create"|"issue edit"|"issue comment"|"issue close"|"pr create"|"pr edit"|"pr comment"|"pr review"|"pr close") MODE=cli ;;
    "api "*) MODE=api ;;
esac
SAVED=''
for a in "$@"; do
    case "$a" in -|*=-|*=@-|@-|*/dev/stdin) SAVED=1; break ;; esac
done
WORK=''
IN=''

start() {
    WORK=$(mktemp -d) || return 1
    trap 'rm -rf "$WORK"' EXIT
    trap 'exit 143' TERM INT
    if [ -n "$SAVED" ]; then IN=$WORK/in; cat > "$IN"; fi
}

take() {
    case "$1" in
        text) printf '%s\n' "$2" ;;
        file) case "$2" in -|/dev/stdin) cat "$IN" ;; *) cat -- "$2" ;; esac 2>/dev/null ;;
        raw) case "$2" in body=*|title=*|query=*) printf '%s\n' "${2#*=}" ;; esac ;;
        field) case "$2" in body=@*|title=@*|query=@*) take file "${2#*=@}" ;; body=*|title=*|query=*) printf '%s\n' "${2#*=}" ;; esac ;;
    esac
}

posted() {
    want=''
    for a in "$@"; do
        if [ -n "$want" ]; then take "$want" "$a"; want=''; continue; fi
        case "$MODE $a" in
            "cli --body"|"cli -b"|"cli --title"|"cli -t"|"cli --comment"|"cli -c") want=text ;;
            "cli --body-file"|"cli -F"|"api --input") want=file ;;
            "api -f"|"api --raw-field") want=raw ;;
            "api -F"|"api --field") want=field ;;
            "cli --body="*|"cli --title="*|"cli --comment="*) take text "${a#*=}" ;;
            "cli --body-file="*|"api --input="*) take file "${a#*=}" ;;
            "api --raw-field="*) take raw "${a#*=}" ;;
            "api --field="*) take field "${a#*=}" ;;
            "cli -b"?*) take text "${a#-b}" ;;
            "cli -t"?*) take text "${a#-t}" ;;
            "cli -c"?*) take text "${a#-c}" ;;
        esac
    done
}

mention() {
    awk '
        /^[ \t]*(```|~~~)/ { fence = !fence; next }
        fence { next }
        {
            s = $0
            gsub(/`[^`]*`/, "", s)
            s = " " s
            while (match(s, /[^A-Za-z0-9_.\/`-]@[A-Za-z0-9][A-Za-z0-9-]*/)) {
                t = substr(s, RSTART + 2, RLENGTH - 2)
                s = substr(s, RSTART + RLENGTH)
                if (!(t ~ /^[0-9a-fA-F]+$/ && length(t) >= 7)) { print "@" t; exit }
            }
        }' "$1"
}

if [ -n "$MODE$SAVED" ] && ! start; then
    [ -z "$MODE" ] || { echo "gh wrapper: no temporary folder to check the text in. Nothing was posted." >&2; exit 75; }
    WORK=''
fi
if [ -n "$MODE" ]; then
    posted "$@" > "$WORK/posted"
    found=$(mention "$WORK/posted")
    if [ -n "$found" ]; then
        echo "gh wrapper: GitHub notifies every @name, so write names without @ (found: $found). Nothing was posted." >&2
        exit 65
    fi
fi

shared() {
    GH_TOKEN=$(tr -d '\r\n' < "$KEY"); export GH_TOKEN
    [ -n "$WORK" ] || exec "$REAL" "$@"
    if [ -n "$IN" ]; then "$REAL" "$@" < "$IN"; else "$REAL" "$@"; fi
    exit $?
}

APP_TOKEN=''
APP_UNTIL=''
if [ -r "$APP" ]; then
    { IFS= read -r APP_TOKEN; IFS= read -r APP_UNTIL; } < "$APP" 2>/dev/null || true
fi
case "$APP_UNTIL" in ''|*[!0-9]*) shared "$@" ;; esac
[ -n "$APP_TOKEN" ] && [ "$(date +%s)" -lt $((APP_UNTIL - 300)) ] || shared "$@"

[ -n "$WORK" ] || start || shared "$@"

run_with() {
    T=$1
    shift
    if [ -n "$IN" ]; then GH_TOKEN=$T "$REAL" "$@" < "$IN"; else GH_TOKEN=$T "$REAL" "$@"; fi
}

{ run_with "$APP_TOKEN" "$@" 2> "$WORK/err"; echo $? > "$WORK/rc"; } | tee "$WORK/out"
rc=$(cat "$WORK/rc")
if [ "$rc" -ne 0 ] && [ ! -s "$WORK/out" ] && grep -qE 'Resource not accessible by integration|HTTP 40[34]|Could not resolve to a Repository|exceeded a secondary rate limit|submitted too quickly' "$WORK/err"; then
    echo "gh wrapper: the factory App was refused here, so this ran again and used the shared key" >&2
    run_with "$(tr -d '\r\n' < "$KEY")" "$@"
    exit $?
fi
cat "$WORK/err" >&2
exit "$rc"
