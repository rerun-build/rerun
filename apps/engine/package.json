{
    "name": "rerun-engine",
    "type": "module",
    "bin": {
        "rerun": "./dist/cli/bin.js"
    },
    "files": [
        "dist",
        "assets",
        "patches",
        "scripts"
    ],
    "scripts": {
        "dev": "tsx watch --env-file-if-exists=.env src/cli/bin.ts run",
        "build": "tsc",
        "start": "node dist/cli/bin.js run",
        "migrate": "tsx src/cli/bin.ts migrate",
        "ts-check": "tsc --noEmit",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "@ai-sdk/anthropic": "^3.0.138",
        "@ai-sdk/google": "^3.0.80",
        "@ai-sdk/openai": "^3.0.67",
        "@hono/node-server": "^1.19.14",
        "@libsql/client": "^0.17.3",
        "@modelcontextprotocol/sdk": "^1.32.2",
        "@rerun/contracts": "workspace:*",
        "ai": "^6.0.194",
        "ai-sdk-provider-claude-code": "^3.5.3",
        "ai-sdk-provider-codex-cli": "^1.3.1",
        "croner": "^10.0.1",
        "drizzle-orm": "^0.45.2",
        "gray-matter": "^4.0.3",
        "hono": "^4.13.16",
        "nanoid": "^5.1.16",
        "patchright": "^1.63.0",
        "pino": "^10.3.1",
        "sharp": "^0.35.5",
        "tar": "^7.5.22",
        "ws": "^8.21.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@types/node": "^20.11.17",
        "@types/ws": "^8.18.1",
        "@vitest/coverage-v8": "4.1.8",
        "tsx": "^4.7.1",
        "typescript": "^5.8.3",
        "vitest": "^4.1.8"
    },
    "license": "AGPL-3.0-only"
}
